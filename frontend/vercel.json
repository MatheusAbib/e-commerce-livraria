{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "http://64.227.6.51:8081/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "http://64.227.6.51:8081/uploads/$1"
    },
    {
      "src": "/(.*)\\.(js|css|woff2|woff|ttf|svg|png|jpg|jpeg|gif|ico|json|map)",
      "dest": "/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
